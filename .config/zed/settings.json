{
  "buffer_font_family": ".ZedMono",
  "terminal": {
    "font_size": 16.0
  },
  "buffer_font_weight": 400.0,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "auto_install_extensions": {
    "luau": true,
    "nix": true,
    "rose-pine-theme": true,
    "html": true,
    "terraform": true
  },
  "buffer_font_size": 14.0,
  "cursor_blink": false,
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "edit_predictions": null,
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "languages": {
    "Luau": {
      "formatter": {
        "external": {
          "arguments": [
            "-"
          ],
          "command": "stylua"
        }
      }
    },
    "Nix": {
      "language_servers": [
        "nixd"
      ]
    }
  },
  "lsp": {
    "luau-lsp": {
      "settings": {
        "ext": {
          "fflags": {
            "enable_new_solver": true,
            "sync": true
          },
          "roblox": {
            "enabled": true,
            "security_level": "plugin"
          }
        },
        "luau-lsp": {
          "completion": {
            "imports": {
              "enabled": true,
              "suggestRequires": true,
              "suggestServices": true
            }
          }
        }
      }
    },
    "nixd": {
      "initialization_options": {
        "formatting": {
          "command": [
            "nixfmt",
            "--quiet",
            "--"
          ]
        }
      }
    }
  },
  "relative_line_numbers": "enabled",
  "theme": {
    "dark": "Rosé Pine",
    "light": "Rosé Pine",
    "mode": "system"
  },
  "ui_font_size": 15.0,
  "vim_mode": true,
  "cursor_shape": "block",
  "session": {
    "trust_all_worktrees": true
  }
}
