{
  "cursor_shape": "block",
  "session": {
    "trust_all_worktrees": true,
  },
  "auto_install_extensions": {
    "luau": true,
    "nix": true,
    "rose-pine-theme": true,
    "terraform": true,
    "html": true,
  },
  "buffer_font_size": 16,
  "cursor_blink": false,
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "edit_predictions": null,
  "features": {
    "edit_prediction_provider": "none",
  },
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "languages": {
    "Luau": {
      "formatter": {
        "external": {
          "arguments": ["-"],
          "command": "stylua",
        },
      },
    },
    "Nix": {
      "language_servers": ["nixd"],
    },
  },
  "lsp": {
    "luau-lsp": {
      "settings": {
        "ext": {
          "fflags": {
            "enable_new_solver": true,
            "sync": true,
          },
          "roblox": {
            "enabled": true,
            "security_level": "plugin",
          },
        },
        "luau-lsp": {
          "completion": {
            "imports": {
              "enabled": true,
              "suggestRequires": true,
              "suggestServices": true,
            },
          },
        },
      },
    },
    "nixd": {
      "initialization_options": {
        "formatting": {
          "command": ["nixfmt", "--quiet", "--"],
        },
      },
    },
  },
  "relative_line_numbers": true,
  "theme": {
    "dark": "Rosé Pine",
    "light": "Rosé Pine",
    "mode": "system",
  },
  "ui_font_size": 16,
  "vim_mode": true,
}
